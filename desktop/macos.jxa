ObjC.import('Foundation');
ObjC.import('AppKit');
ObjC.import('CoreGraphics');

const rawRequest = ObjC.unwrap($.NSProcessInfo.processInfo.environment.objectForKey('CODEX_PLUS_DESKTOP_REQUEST'));
const request = JSON.parse(rawRequest);

function number(value) {
  return Number(value);
}

function cursorPoint() {
  const event = $.CGEventCreate(null);
  const point = $.CGEventGetLocation(event);
  return { x: number(point.x), y: number(point.y) };
}

function mainScreen() {
  const displayId = $.CGMainDisplayID();
  const bounds = $.CGDisplayBounds(displayId);
  const screen = $.NSScreen.mainScreen;
  const scaleFactor = number(screen.backingScaleFactor);
  return {
    left: number(bounds.origin.x),
    top: number(bounds.origin.y),
    width: number(bounds.size.width),
    height: number(bounds.size.height),
    scaleFactor,
    backingPixelWidth: Math.round(number(bounds.size.width) * scaleFactor),
    backingPixelHeight: Math.round(number(bounds.size.height) * scaleFactor),
    quartzReportedWidth: number($.CGDisplayPixelsWide(displayId)),
    quartzReportedHeight: number($.CGDisplayPixelsHigh(displayId)),
  };
}

function visibleWindows() {
  const options = Number($.kCGWindowListOptionOnScreenOnly) | Number($.kCGWindowListExcludeDesktopElements);
  const rawList = $.CGWindowListCopyWindowInfo(options, $.kCGNullWindowID);
  const list = ObjC.castRefToObject(rawList);
  const result = [];
  for (let index = 0; index < Number(list.count); index += 1) {
    const info = ObjC.deepUnwrap(list.objectAtIndex(index));
    const bounds = info.kCGWindowBounds || {};
    const width = Number(bounds.Width || 0);
    const height = Number(bounds.Height || 0);
    const layer = Number(info.kCGWindowLayer || 0);
    if (width <= 1 || height <= 1 || layer !== 0) continue;
    const left = Number(bounds.X || 0);
    const top = Number(bounds.Y || 0);
    result.push({
      handle: Number(info.kCGWindowNumber || 0),
      process: String(info.kCGWindowOwnerName || ''),
      processId: Number(info.kCGWindowOwnerPID || 0),
      title: String(info.kCGWindowName || ''),
      rect: {
        left,
        top,
        width,
        height,
        right: left + width,
        bottom: top + height,
      },
    });
  }
  return result;
}

function eventSource() {
  return $.CGEventSourceCreate($.kCGEventSourceStateCombinedSessionState);
}

function postMouse(type, x, y, button) {
  const event = $.CGEventCreateMouseEvent(eventSource(), type, $.CGPointMake(x, y), button);
  $.CGEventPost($.kCGHIDEventTap, event);
}

function moveMouse(x, y) {
  postMouse($.kCGEventMouseMoved, x, y, $.kCGMouseButtonLeft);
}

function clickMouse(x, y, button, count) {
  const downType = button === $.kCGMouseButtonRight ? $.kCGEventRightMouseDown : $.kCGEventLeftMouseDown;
  const upType = button === $.kCGMouseButtonRight ? $.kCGEventRightMouseUp : $.kCGEventLeftMouseUp;
  for (let index = 0; index < count; index += 1) {
    const down = $.CGEventCreateMouseEvent(eventSource(), downType, $.CGPointMake(x, y), button);
    $.CGEventSetIntegerValueField(down, $.kCGMouseEventClickState, count);
    $.CGEventPost($.kCGHIDEventTap, down);
    const up = $.CGEventCreateMouseEvent(eventSource(), upType, $.CGPointMake(x, y), button);
    $.CGEventSetIntegerValueField(up, $.kCGMouseEventClickState, count);
    $.CGEventPost($.kCGHIDEventTap, up);
  }
}

const keyCodes = {
  A: 0, S: 1, D: 2, F: 3, H: 4, G: 5, Z: 6, X: 7, C: 8, V: 9, B: 11,
  Q: 12, W: 13, E: 14, R: 15, Y: 16, T: 17, '1': 18, '2': 19, '3': 20,
  '4': 21, '6': 22, '5': 23, '9': 25, '7': 26, '8': 28, '0': 29, O: 31, U: 32,
  I: 34, P: 35, RETURN: 36, ENTER: 36, L: 37, J: 38, K: 40, N: 45, M: 46,
  TAB: 48, SPACE: 49, BACKSPACE: 51, DELETE: 51, ESC: 53, ESCAPE: 53,
  CMD: 55, COMMAND: 55, SHIFT: 56, ALT: 58, OPTION: 58, CTRL: 59, CONTROL: 59,
  HOME: 115, END: 119, PAGEUP: 116, PAGEDOWN: 121, LEFT: 123, RIGHT: 124, DOWN: 125, UP: 126,
};

function resolveKeyCode(name) {
  const normalized = String(name).toUpperCase();
  if (Object.prototype.hasOwnProperty.call(keyCodes, normalized)) return keyCodes[normalized];
  throw new Error(`Unsupported key: ${name}`);
}

function keyEvent(keyCode, down) {
  const event = $.CGEventCreateKeyboardEvent(eventSource(), keyCode, down);
  $.CGEventPost($.kCGHIDEventTap, event);
}

function sendKeyChord(chord) {
  const parts = String(chord).split('+').filter(Boolean);
  if (!parts.length) throw new Error('key must not be empty');
  let flags = 0;
  for (const modifier of parts.slice(0, -1)) {
    const normalized = String(modifier).toUpperCase();
    if (normalized === 'CMD' || normalized === 'COMMAND') flags |= Number($.kCGEventFlagMaskCommand);
    else if (normalized === 'CTRL' || normalized === 'CONTROL') flags |= Number($.kCGEventFlagMaskControl);
    else if (normalized === 'ALT' || normalized === 'OPTION') flags |= Number($.kCGEventFlagMaskAlternate);
    else if (normalized === 'SHIFT') flags |= Number($.kCGEventFlagMaskShift);
    else throw new Error(`Unsupported modifier: ${modifier}`);
  }
  const primary = resolveKeyCode(parts[parts.length - 1]);
  const down = $.CGEventCreateKeyboardEvent(eventSource(), primary, true);
  const up = $.CGEventCreateKeyboardEvent(eventSource(), primary, false);
  if (flags) {
    $.CGEventSetFlags(down, flags);
    $.CGEventSetFlags(up, flags);
  }
  $.CGEventPost($.kCGHIDEventTap, down);
  $.CGEventPost($.kCGHIDEventTap, up);
}

function uiElementSummary(element) {
  let name = '';
  let role = '';
  let description = '';
  let value = null;
  let position = null;
  let size = null;
  try { name = String(element.name()); } catch (_) {}
  try { role = String(element.role()); } catch (_) {}
  try { description = String(element.description()); } catch (_) {}
  try { value = element.value(); } catch (_) {}
  try { position = element.position(); } catch (_) {}
  try { size = element.size(); } catch (_) {}
  return {
    name,
    role,
    description,
    value: value == null ? null : String(value),
    bounds: position && size ? {
      x: Number(position[0]), y: Number(position[1]), width: Number(size[0]), height: Number(size[1]),
    } : null,
  };
}

function findUiElements(req) {
  if (!req.app) throw new Error('uia operation requires app');
  const systemEvents = Application('System Events');
  const process = systemEvents.applicationProcesses.byName(String(req.app));
  if (!process.exists()) throw new Error(`Application process not found: ${req.app}`);
  const limit = Math.min(Number(req.limit || 20), 100);
  const maxDepth = Math.min(Number(req.maxDepth || 7), 12);
  const maxVisited = Math.min(Number(req.maxVisited || 800), 3000);
  const queue = [];
  let windows = [];
  try { windows = process.windows(); } catch (_) {}
  if (req.windowTitle) {
    windows = windows.filter(window => {
      try { return String(window.name()) === String(req.windowTitle); } catch (_) { return false; }
    });
  }
  for (const window of windows) queue.push({ element: window, depth: 0 });
  const matches = [];
  let visited = 0;
  while (queue.length && matches.length < limit && visited < maxVisited) {
    const { element, depth } = queue.shift();
    visited += 1;
    const summary = uiElementSummary(element);
    const nameMatches = !req.name || summary.name === String(req.name);
    const roleMatches = !req.role || summary.role === String(req.role);
    const descriptionMatches = !req.description || summary.description === String(req.description);
    if (nameMatches && roleMatches && descriptionMatches) matches.push({ element, summary });
    if (depth < maxDepth) {
      try {
        for (const child of element.uiElements()) queue.push({ element: child, depth: depth + 1 });
      } catch (_) {}
    }
  }
  return matches;
}

let result;
switch (String(request.operation)) {
  case 'state':
    result = { cursor: cursorPoint(), screen: mainScreen(), windows: visibleWindows() };
    break;
  case 'windows':
    result = { windows: visibleWindows() };
    break;
  case 'mouse': {
    const action = String(request.action);
    const current = cursorPoint();
    const x = request.x == null ? current.x : Number(request.x);
    const y = request.y == null ? current.y : Number(request.y);
    if (action === 'move') moveMouse(x, y);
    else if (action === 'click') clickMouse(x, y, $.kCGMouseButtonLeft, 1);
    else if (action === 'double_click') clickMouse(x, y, $.kCGMouseButtonLeft, 2);
    else if (action === 'right_click') clickMouse(x, y, $.kCGMouseButtonRight, 1);
    else if (action === 'scroll') {
      const event = $.CGEventCreateScrollWheelEvent(eventSource(), $.kCGScrollEventUnitPixel, 1, Number(request.deltaY || 0));
      $.CGEventPost($.kCGHIDEventTap, event);
    } else throw new Error(`Unsupported mouse action: ${action}`);
    delay(0.02);
    result = { action, cursor: cursorPoint() };
    break;
  }
  case 'keyboard': {
    if (request.text != null) {
      Application('System Events').keystroke(String(request.text));
      result = { typed: true, length: String(request.text).length };
    } else if (request.key) {
      sendKeyChord(String(request.key));
      result = { key: String(request.key) };
    } else throw new Error('keyboard requires text or key');
    break;
  }
  case 'uia_find': {
    const matches = findUiElements(request);
    result = { elements: matches.map(item => item.summary) };
    break;
  }
  case 'uia_action': {
    const matches = findUiElements(Object.assign({}, request, { limit: 1 }));
    if (!matches.length) throw new Error('Accessibility element not found');
    const element = matches[0].element;
    const action = String(request.action);
    if (action === 'click' || action === 'invoke') element.click();
    else if (action === 'focus') {
      const systemEvents = Application('System Events');
      systemEvents.applicationProcesses.byName(String(request.app)).frontmost = true;
    } else if (action === 'set_value') element.value = String(request.value == null ? '' : request.value);
    else throw new Error(`Unsupported accessibility action: ${action}`);
    result = { action, element: matches[0].summary };
    break;
  }
  default:
    throw new Error(`Unsupported desktop operation: ${request.operation}`);
}

JSON.stringify(result);
