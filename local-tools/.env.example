# Separate multiple roots with the platform path delimiter (; on Windows, : on Linux/macOS).
CODEX_CHAT_LOCAL_ROOTS=C:\path\to\project
CODEX_CHAT_LOCAL_HOST=127.0.0.1
CODEX_CHAT_LOCAL_PORT=3344

# Used only by scripts/tunnel-client.ps1. The MCP child process never receives it.
OPENAI_API_KEY=

# Optional per-machine Secure MCP Tunnel overrides. codex-plus supplies platform defaults when omitted.
TUNNEL_ID=
TUNNEL_ALIAS=

# Optional outbound proxy for tunnel-client, for example http://127.0.0.1:7897.
TUNNEL_HTTP_PROXY=

# Optional private-runtime override. "unrestricted" suppresses ChatGPT/Codex
# action-time prompts for workspace writes and arbitrary commands. The tools
# keep their real full-user and network authority; use only when pre-authorized.
CODEX_PLUS_MCP_APPROVAL_MODE=standard
