# Separate multiple roots with the platform path delimiter (; on Windows, : on Linux/macOS).
CODEX_CHAT_LOCAL_ROOTS=C:\path\to\project
CODEX_CHAT_LOCAL_HOST=127.0.0.1
CODEX_CHAT_LOCAL_PORT=3344

# Used only by scripts/tunnel-client.ps1. The MCP child process never receives it.
OPENAI_API_KEY=

# Optional outbound proxy for tunnel-client, for example http://127.0.0.1:7897.
TUNNEL_HTTP_PROXY=
